<Window
    x:Class="ToastMonitor.WinUI.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    Title="ToastMonitor 设置">
    <Grid x:Name="RootGrid" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <controls:TabView x:Name="SettingsTabs" Grid.Row="0" IsAddTabButtonVisible="False" CanDragTabs="False" CanReorderTabs="False">
            <controls:TabView.TabItems>
                <controls:TabViewItem IsClosable="False" Header="通用">
                    <StackPanel Margin="0,12,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Width="180" VerticalAlignment="Center" Text="后台轮询间隔（秒）" />
                            <TextBox x:Name="PollIntervalBox" Width="80" TextChanged="PollInterval_Changed" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Width="180" VerticalAlignment="Center" Text="额度显示" />
                            <CheckBox Content="显示剩余（不勾则显示已用）" IsChecked="{Binding ShowRemaining, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Width="180" VerticalAlignment="Center" Text="用量周期模式" />
                            <ComboBox x:Name="PeriodModeBox" Width="140" SelectionChanged="PeriodMode_Changed">
                                <ComboBoxItem Content="最近（7/30 天）" Tag="Recent" />
                                <ComboBoxItem Content="自然周/月" Tag="Calendar" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Width="180" VerticalAlignment="Center" Text="周起始日" />
                            <ComboBox x:Name="WeekStartBox" Width="140" SelectionChanged="WeekStart_Changed">
                                <ComboBoxItem Content="周一" Tag="Monday" />
                                <ComboBoxItem Content="周日" Tag="Sunday" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Width="180" VerticalAlignment="Center" Text="托盘提示字体大小" />
                            <TextBox x:Name="TrayFontSizeBox" Width="80" TextChanged="TrayFontSize_Changed" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Width="180" VerticalAlignment="Center" Text="托盘提示内容" />
                            <ComboBox x:Name="TrayTextBox" Width="140" SelectionChanged="TrayText_Changed">
                                <ComboBoxItem Content="今日花费" Tag="cost" />
                                <ComboBoxItem Content="今日 Tokens" Tag="tokens" />
                                <ComboBoxItem Content="仅名称" Tag="none" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Width="180" VerticalAlignment="Center" Text="额度刷新间隔（分钟）" />
                            <TextBox x:Name="QuotaRefreshBox" Width="80" TextChanged="QuotaRefresh_Changed" />
                        </StackPanel>
                    </StackPanel>
                </controls:TabViewItem>
                <controls:TabViewItem IsClosable="False" Header="平台">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,12,0,0">
                            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="开机自启" />
                            <CheckBox Margin="0,8,0,0" Content="登录 Windows 时自动启动 ToastMonitor" IsChecked="{Binding AutoStartEnabled, Mode=TwoWay}" />
                            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,16,0,0" Text="更新检查" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Width="180" VerticalAlignment="Center" Text="检查地址（可空）" />
                                <TextBox Width="340" Text="{Binding UpdateCheckUrl, Mode=TwoWay}" />
                                <Button Content="立即检查" Width="90" Margin="8,0,0,0" Click="UpdateCheck_Click" />
                            </StackPanel>
                            <TextBlock TextWrapping="Wrap" Text="{Binding UpdateStatus}" />
                            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,16,0,0" Text="DeepSeek 手动登录" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Width="180" VerticalAlignment="Center" Text="API Key" />
                                <TextBox Width="340" Text="{Binding DeepSeekApiInput, Mode=TwoWay}" />
                                <Button Content="保存" Width="70" Margin="8,0,0,0" Click="DeepSeekApiSave_Click" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Width="180" VerticalAlignment="Center" Text="平台会话凭据 userToken" />
                                <TextBox Width="340" Text="{Binding DeepSeekPlatformInput, Mode=TwoWay}" />
                                <Button Content="保存" Width="70" Margin="8,0,0,0" Click="DeepSeekPlatformSave_Click" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="校验已保存的 DeepSeek 凭据" Width="180" Click="DeepSeekValidate_Click" />
                                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding DeepSeekStatus}" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,16,0,0" Text="数据备份与恢复" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="立即备份" Width="90" Click="Backup_Click" />
                                <Button Content="从备份恢复…" Width="110" Margin="8,0,0,0" Click="Restore_Click" />
                                <Button Content="清空全部用量数据" Width="130" Margin="8,0,0,0" Click="ClearData_Click" />
                            </StackPanel>
                            <TextBlock TextWrapping="Wrap" Text="{Binding BackupStatus}" />
                        </StackPanel>
                    </ScrollViewer>
                </controls:TabViewItem>
                <controls:TabViewItem IsClosable="False" Header="账号">
                    <StackPanel Margin="0,12,0,0">
                        <Grid Margin="0,0,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="260" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource CaptionTextBlockStyle}" Text="工具" />
                            <TextBlock Grid.Column="1" Style="{StaticResource CaptionTextBlockStyle}" Text="启用" />
                            <TextBlock Grid.Column="2" Style="{StaticResource CaptionTextBlockStyle}" Text="远程" />
                            <TextBlock Grid.Column="3" Style="{StaticResource CaptionTextBlockStyle}" Text="路径" />
                            <TextBlock Grid.Column="4" Style="{StaticResource CaptionTextBlockStyle}" Text="凭据已配置" />
                        </Grid>
                        <ListView ItemsSource="{Binding Sources}">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="260" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding DisplayName}" />
                                        <CheckBox Grid.Column="1" IsChecked="{Binding Enabled, Mode=TwoWay}" />
                                        <TextBlock Grid.Column="2" Text="{Binding IsRemote}" />
                                        <TextBlock Grid.Column="3" Text="{Binding Path}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="4" Text="{Binding CredentialConfigured}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </controls:TabViewItem>
                <controls:TabViewItem IsClosable="False" Header="订阅">
                    <StackPanel Margin="0,12,0,0">
                        <Grid Margin="0,0,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource CaptionTextBlockStyle}" Text="名称" />
                            <TextBlock Grid.Column="1" Style="{StaticResource CaptionTextBlockStyle}" Text="套餐" />
                            <TextBlock Grid.Column="2" Style="{StaticResource CaptionTextBlockStyle}" Text="周期" />
                            <TextBlock Grid.Column="3" Style="{StaticResource CaptionTextBlockStyle}" Text="价格" />
                        </Grid>
                        <ListView ItemsSource="{Binding Subscriptions}" SelectionChanged="Subscription_SelectionChanged">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Plan}" />
                                        <TextBlock Grid.Column="2" Text="{Binding Cycle}" />
                                        <TextBlock Grid.Column="3" Text="{Binding Price, Converter={StaticResource Fmt}, ConverterParameter='C2'}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <TextBox Width="160" Text="{Binding NewSubName, Mode=TwoWay}" />
                            <TextBox Width="100" Margin="8,0,0,0" Text="{Binding NewSubPrice, Mode=TwoWay}" />
                            <Button Content="添加（月付）" Width="110" Margin="8,0,0,0" Click="AddSub_Click" />
                            <Button Content="删除选中" Width="90" Margin="8,0,0,0" Click="DeleteSub_Click" />
                        </StackPanel>
                    </StackPanel>
                </controls:TabViewItem>
            </controls:TabView.TabItems>
        </controls:TabView>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="保存" Click="Save_Click" />
            <Button Content="取消" Margin="8,0,0,0" Click="Cancel_Click" />
        </StackPanel>
    </Grid>
</Window>
