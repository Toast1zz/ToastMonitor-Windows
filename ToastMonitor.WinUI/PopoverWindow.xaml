<Window x:Class="ToastMonitor.WinUI.PopoverWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ToastMonitor">
 <Grid x:Name="RootGrid" KeyDown="Root_KeyDown" Background="{ThemeResource TMCanvasBrush}" Width="388">
 <Border BorderBrush="{ThemeResource TMLineBrush}" BorderThickness="1" CornerRadius="12">
 <Grid><Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <Grid Padding="20,0,14,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
 <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
  <Border Width="25" Height="25" CornerRadius="8" Background="{ThemeResource TMAccentBrush}"><TextBlock Text="t" FontSize="22" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,-4,0,0"/></Border>
  <TextBlock Text="ToastMonitor" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
 </StackPanel>
 <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
  <Button x:Name="RefreshQuotaButton" Click="RefreshQuota_Click" Padding="8" Background="Transparent" BorderThickness="0" AutomationProperties.Name="刷新用量与额度" ToolTipService.ToolTip="刷新用量与额度"><FontIcon Glyph="&#xE72C;" FontSize="14" Foreground="{ThemeResource TMMutedBrush}"/></Button>
  <Button Click="Settings_Click" Padding="8" Background="Transparent" BorderThickness="0" AutomationProperties.Name="设置" ToolTipService.ToolTip="设置"><FontIcon Glyph="&#xE713;" FontSize="15" Foreground="{ThemeResource TMMutedBrush}"/></Button>
 </StackPanel></Grid>
 <ScrollViewer x:Name="PopoverScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20,0,20,0">
 <StackPanel x:Name="PopoverBody" Spacing="20" Padding="0,0,0,20">
 <Border Style="{StaticResource TMCard}" Padding="18">
 <StackPanel Spacing="14"><Grid><TextBlock Text="今日用量" FontSize="12" FontWeight="SemiBold"/>
 <ProgressRing Width="14" Height="14" HorizontalAlignment="Right" IsActive="{Binding IsRefreshing}" Visibility="{Binding IsRefreshing, Converter={StaticResource BoolToVis}}" Foreground="{ThemeResource TMAccentBrush}"/></Grid>
 <Grid ColumnSpacing="18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
 <StackPanel><TextBlock Text="{Binding TodayCostText}" FontSize="30" FontWeight="SemiLight"/><TextBlock Text="记录花费 · USD" Style="{StaticResource TMCaption}" FontSize="11" Margin="0,5,0,0"/></StackPanel>
 <Border Grid.Column="1" BorderThickness="1,0,0,0" BorderBrush="{ThemeResource TMLineBrush}" Padding="18,0,0,0"><StackPanel><TextBlock Text="{Binding TodayTokensText}" FontSize="30" FontWeight="SemiLight"/><TextBlock Text="Tokens" Style="{StaticResource TMCaption}" FontSize="11" Margin="0,5,0,0"/></StackPanel></Border>
 </Grid>
 <Grid BorderBrush="{ThemeResource TMLineBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0"><TextBlock Text="{Binding WeekLabel}" Style="{StaticResource TMCaption}"/><TextBlock Text="{Binding WeekCostText}" HorizontalAlignment="Right" FontSize="12"/></Grid>
 </StackPanel></Border>
 <StackPanel Spacing="12" Visibility="{Binding HasByToolRows, Converter={StaticResource BoolToVis}}"><TextBlock Text="工具分布" Style="{StaticResource TMSection}"/>
 <ItemsControl ItemsSource="{Binding ByToolToday}"><ItemsControl.ItemTemplate><DataTemplate>
 <Grid Padding="0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
 <StackPanel Spacing="3"><TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="{Binding TotalTokens, Converter={StaticResource Fmt}, ConverterParameter=N0}" Style="{StaticResource TMCaption}"/></StackPanel>
 <TextBlock Grid.Column="1" Text="{Binding Cost, Converter={StaticResource Fmt}, ConverterParameter=USD}" FontSize="13" VerticalAlignment="Center"/>
 </Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
 <Border Background="{ThemeResource TMAccentSoftBrush}" CornerRadius="8" Padding="16" Visibility="{Binding ByToolEmpty, Converter={StaticResource BoolToVis}}">
 <StackPanel Spacing="7"><TextBlock Text="等待今天的第一条记录" FontSize="13" FontWeight="SemiBold"/>
 <TextBlock Text="在这台电脑上使用 AI 工具后，用量会自动更新。" Style="{StaticResource TMCaption}" TextWrapping="Wrap"/></StackPanel></Border>
 <StackPanel Spacing="12"><Grid><TextBlock Text="账户额度" Style="{StaticResource TMSection}"/><TextBlock Text="消耗进度" Style="{StaticResource TMCaption}" HorizontalAlignment="Right"/></Grid>
 <ItemsControl ItemsSource="{Binding VisibleQuotaRows}" Visibility="{Binding HasQuotaRows, Converter={StaticResource BoolToVis}}"><ItemsControl.ItemTemplate><DataTemplate>
 <StackPanel Margin="0,0,0,14" Spacing="7"><TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"/>
 <TextBlock Text="{Binding StatusText}" Style="{StaticResource TMCaption}" TextWrapping="Wrap"/>
 <ItemsControl ItemsSource="{Binding Windows}"><ItemsControl.ItemTemplate><DataTemplate>
 <StackPanel Spacing="6" Margin="0,4,0,4"><Grid><TextBlock Text="{Binding Label}" Style="{StaticResource TMCaption}"/><TextBlock Text="{Binding UsedPercentClamped, Converter={StaticResource Fmt}, ConverterParameter='已用 {0:F0}%'}" Style="{StaticResource TMCaption}" HorizontalAlignment="Right"/></Grid>
 <ProgressBar Minimum="0" Maximum="100" Value="{Binding UsedPercentClamped}" Height="4" Foreground="{ThemeResource TMAccentBrush}" Background="{ThemeResource TMLineBrush}"/>
 <TextBlock Text="{Binding ResetText}" Style="{StaticResource TMCaption}" FontSize="11"/>
 </StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
 </StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
 <Grid Visibility="{Binding QuotaEmpty, Converter={StaticResource BoolToVis}}" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
 <TextBlock Text="连接账户后查看余额与限额" Style="{StaticResource TMCaption}" VerticalAlignment="Center"/>
 <HyperlinkButton Grid.Column="1" Content="去设置" Click="AccountSettings_Click" FontSize="12" Padding="4" Foreground="{ThemeResource TMAccentBrush}"/>
 </Grid></StackPanel>
 <StackPanel Spacing="12"><TextBlock Text="最近会话" Style="{StaticResource TMSection}"/>
 <TextBlock Text="还没有本机会话" Style="{StaticResource TMCaption}" Visibility="{Binding SessionEmpty, Converter={StaticResource BoolToVis}}"/>
 <ItemsControl ItemsSource="{Binding PreviewSessions}" Visibility="{Binding HasSessionRows, Converter={StaticResource BoolToVis}}"><ItemsControl.ItemTemplate><DataTemplate>
 <Grid Padding="0,8" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
 <StackPanel Spacing="3"><TextBlock Text="{Binding Title}" FontSize="13" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Tool}" Style="{StaticResource TMCaption}" FontSize="11"/></StackPanel>
 <TextBlock Grid.Column="1" Text="{Binding Cost, Converter={StaticResource Fmt}, ConverterParameter=USD}" FontSize="12" VerticalAlignment="Center"/>
 </Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
 </StackPanel>
 </StackPanel></ScrollViewer>
 <StackPanel x:Name="PopoverFooter" Grid.Row="2" Padding="20,14,20,16" BorderBrush="{ThemeResource TMLineBrush}" BorderThickness="0,1,0,0" Spacing="12">
 <TextBlock Text="{Binding LastScanText}" Style="{StaticResource TMCaption}" FontSize="11" TextTrimming="CharacterEllipsis"/>
 <Button x:Name="DashboardButton" Content="打开总览  →" AutomationProperties.Name="Dashboard" Click="Dashboard_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Style="{StaticResource TMAction}"/>
 </StackPanel>
 </Grid></Border>
 </Grid>
</Window>