<Window x:Class="ToastMonitor.WinUI.DashboardWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="ToastMonitor Dashboard">
 <Grid x:Name="RootGrid" Loaded="Root_Loaded" Background="{ThemeResource TMCanvasBrush}">
 <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions>
 <Grid x:Name="AppTitleBar" Background="{ThemeResource TMSidebarBrush}" Padding="20,0,160,0">
  <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
   <Border Width="25" Height="25" CornerRadius="8" Background="{ThemeResource TMAccentBrush}"><TextBlock Text="t" FontFamily="Segoe UI Variable Display" FontSize="22" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,-4,0,0"/></Border>
   <TextBlock Text="ToastMonitor" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{ThemeResource TMTextBrush}"/>
  </StackPanel>
 </Grid>
 <NavigationView x:Name="Navigation" Grid.Row="1" PaneDisplayMode="Left" IsPaneOpen="True" OpenPaneLength="176" IsPaneToggleButtonVisible="False"
 IsBackButtonVisible="Collapsed" IsSettingsVisible="True" IsTitleBarAutoPaddingEnabled="False" PaneTitle="" SelectionChanged="Navigation_SelectionChanged"
 Background="{ThemeResource TMSidebarBrush}">
 <NavigationView.Resources><SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#BD5737"/></NavigationView.Resources>
 <NavigationView.MenuItems><NavigationViewItem Content="总览" Tag="Overview" x:Name="OverviewNav"><NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;"/></NavigationViewItem.Icon></NavigationViewItem><NavigationViewItem Content="会话" Tag="Sessions" x:Name="SessionsNav"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8F2;"/></NavigationViewItem.Icon></NavigationViewItem><NavigationViewItem Content="套餐" Tag="Plans" x:Name="PlansNav"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8C7;"/></NavigationViewItem.Icon></NavigationViewItem><NavigationViewItem Content="用量分析" Tag="Analysis" x:Name="AnalysisNav"><NavigationViewItem.Icon><FontIcon Glyph="&#xE9D9;"/></NavigationViewItem.Icon></NavigationViewItem><NavigationViewItem Content="性能" Tag="Performance" x:Name="PerformanceNav"><NavigationViewItem.Icon><FontIcon Glyph="&#xE945;"/></NavigationViewItem.Icon></NavigationViewItem></NavigationView.MenuItems>
 <NavigationView.PaneFooter><StackPanel Margin="20,12,12,20" Spacing="5"><TextBlock Text="本机用量" Style="{StaticResource TMCaption}"/><TextBlock Text="记录保存在这台电脑" Style="{StaticResource TMCaption}" FontSize="11"/></StackPanel></NavigationView.PaneFooter>
 <Grid Background="{ThemeResource TMCanvasBrush}" Padding="28,20,28,24">
 <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
 <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
 <StackPanel Spacing="6"><TextBlock x:Name="PageTitle" Text="总览" FontSize="26" FontWeight="SemiBold" Foreground="{ThemeResource TMTextBrush}"/>
 <TextBlock x:Name="PageSubtitle" Text="了解你的 AI 使用与花费" Style="{StaticResource TMCaption}"/></StackPanel>
 <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
 <ProgressRing Width="18" Height="18" IsActive="{Binding IsRefreshing}" Visibility="{Binding IsRefreshing, Converter={StaticResource BoolToVis}}" Foreground="{ThemeResource TMAccentBrush}"/>
 <Button x:Name="RefreshButton" Click="Refresh_Click" Padding="12,7" AutomationProperties.Name="刷新"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE72C;" FontSize="13"/><TextBlock Text="刷新" FontSize="12"/></StackPanel></Button>
 </StackPanel></Grid>
 <InfoBar x:Name="RefreshError" Grid.Row="1" IsOpen="False" Severity="Error" Title="刷新失败" Margin="0,0,0,14"/>
 <ScrollViewer x:Name="PageScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
 <Grid><StackPanel x:Name="OverviewPage" DataContext="{Binding Overview}" Spacing="14">
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
 <Border Padding="3" CornerRadius="8" Background="{ThemeResource TMQuietBrush}" HorizontalAlignment="Left">
 <StackPanel Orientation="Horizontal" Spacing="2">
  <ToggleButton x:Name="TodayPeriod" Content="今日" Tag="Today" Style="{StaticResource TMPeriod}" Checked="Period_Checked" Unchecked="Period_Unchecked"/>
  <ToggleButton x:Name="WeekPeriod" Content="{Binding WeekLabel}" Tag="Week" Style="{StaticResource TMPeriod}" Checked="Period_Checked" Unchecked="Period_Unchecked" IsChecked="True"/>
  <ToggleButton x:Name="MonthPeriod" Content="{Binding MonthLabel}" Tag="Month" Style="{StaticResource TMPeriod}" Checked="Period_Checked" Unchecked="Period_Unchecked"/>
  <ToggleButton x:Name="AllPeriod" Content="全部" Tag="All" Style="{StaticResource TMPeriod}" Checked="Period_Checked" Unchecked="Period_Unchecked"/>
 </StackPanel></Border>
 <TextBlock Grid.Column="1" Text="{Binding ScanStatus}" Style="{StaticResource TMCaption}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
</Grid>
<Border Style="{StaticResource TMCard}" Padding="22,16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Grid.Column="0" BorderBrush="{ThemeResource TMLineBrush}" BorderThickness="0,0,1,0" Padding="0,0,16,0"><StackPanel>
    <TextBlock Text="Tokens" Style="{StaticResource TMCaption}"/><TextBlock Text="{Binding TokensText}" Style="{StaticResource TMNumber}"/>
    <TextBlock Text="含缓存读取" Style="{StaticResource TMCaption}" FontSize="11"/></StackPanel></Border><Border Grid.Column="1" BorderBrush="{ThemeResource TMLineBrush}" BorderThickness="0,0,1,0" Padding="20,0,8,0"><StackPanel>
    <TextBlock Text="调用次数" Style="{StaticResource TMCaption}"/><TextBlock Text="{Binding CallsText}" Style="{StaticResource TMNumber}"/>
    <TextBlock Text="本机记录" Style="{StaticResource TMCaption}" FontSize="11"/></StackPanel></Border><Border Grid.Column="2" BorderBrush="{ThemeResource TMLineBrush}" BorderThickness="0,0,1,0" Padding="20,0,8,0"><StackPanel>
    <TextBlock Text="记录花费" Style="{StaticResource TMCaption}"/><TextBlock Text="{Binding CostText}" Style="{StaticResource TMNumber}"/>
    <TextBlock Text="USD · 含估算" Style="{StaticResource TMCaption}" FontSize="11"/></StackPanel></Border><Border Grid.Column="3" BorderBrush="{ThemeResource TMLineBrush}" BorderThickness="0" Padding="20,0,8,0"><StackPanel>
    <TextBlock Text="API 参考价值" Style="{StaticResource TMCaption}"/><TextBlock Text="{Binding ApiValueText}" Style="{StaticResource TMNumber}"/>
    <TextBlock Text="USD · 按公开定价" Style="{StaticResource TMCaption}" FontSize="11"/></StackPanel></Border></Grid></Border>
<Grid ColumnSpacing="16" Visibility="{Binding HasAnyData, Converter={StaticResource BoolToVis}}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
 <Border Style="{StaticResource TMCard}"><Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid><TextBlock Text="工具分布" Style="{StaticResource TMSection}"/><TextBlock Text="{Binding PeriodLabel}" Style="{StaticResource TMCaption}" HorizontalAlignment="Right"/></Grid>
    <Grid Grid.Row="1" MinHeight="154">
    <StackPanel Visibility="{Binding ToolShares, Converter={StaticResource ItemsVis}, ConverterParameter=Empty}" Padding="16,32" HorizontalAlignment="Center" MaxWidth="440">
    <Border Width="44" Height="44" CornerRadius="12" Background="{ThemeResource TMQuietBrush}" HorizontalAlignment="Center" Margin="0,0,0,14"><FontIcon Glyph="&#xE943;" FontSize="20" Foreground="{ThemeResource TMMutedBrush}"/></Border>
    <TextBlock Text="暂无工具记录" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"/>
    <TextBlock Text="开始使用 AI 工具后，在这里查看分布。" Style="{StaticResource TMCaption}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel>
    <ScrollViewer MaxHeight="210" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,14,0,0" Visibility="{Binding ToolShares, Converter={StaticResource ItemsVis}}">
    <ItemsControl ItemsSource="{Binding ToolShares}"><ItemsControl.ItemTemplate><DataTemplate>
    <StackPanel Margin="0,0,0,16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/><TextBlock Text="{Binding Detail}" Style="{StaticResource TMCaption}" Margin="0,3,0,0"/></StackPanel>
    <TextBlock Grid.Column="1" Text="{Binding CostText}" FontSize="13" VerticalAlignment="Center"/></Grid>
    <ProgressBar Value="{Binding Share}" Minimum="0" Maximum="100" Foreground="{ThemeResource TMAccentBrush}" Background="{ThemeResource TMQuietBrush}" Height="3" Margin="0,8,0,0"/>
    </StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
    </Grid></Grid></Border>
 <Grid Grid.Column="1"><Border Style="{StaticResource TMCard}"><Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid><TextBlock Text="模型分布" Style="{StaticResource TMSection}"/><TextBlock Text="{Binding PeriodLabel}" Style="{StaticResource TMCaption}" HorizontalAlignment="Right"/></Grid>
    <Grid Grid.Row="1" MinHeight="154">
    <StackPanel Visibility="{Binding ModelShares, Converter={StaticResource ItemsVis}, ConverterParameter=Empty}" Padding="16,32" HorizontalAlignment="Center" MaxWidth="440">
    <Border Width="44" Height="44" CornerRadius="12" Background="{ThemeResource TMQuietBrush}" HorizontalAlignment="Center" Margin="0,0,0,14"><FontIcon Glyph="&#xE8A5;" FontSize="20" Foreground="{ThemeResource TMMutedBrush}"/></Border>
    <TextBlock Text="暂无模型记录" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"/>
    <TextBlock Text="模型用量与花费会自动汇总。" Style="{StaticResource TMCaption}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel>
    <ScrollViewer MaxHeight="210" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,14,0,0" Visibility="{Binding ModelShares, Converter={StaticResource ItemsVis}}">
    <ItemsControl ItemsSource="{Binding ModelShares}"><ItemsControl.ItemTemplate><DataTemplate>
    <StackPanel Margin="0,0,0,16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/><TextBlock Text="{Binding Detail}" Style="{StaticResource TMCaption}" Margin="0,3,0,0"/></StackPanel>
    <TextBlock Grid.Column="1" Text="{Binding CostText}" FontSize="13" VerticalAlignment="Center"/></Grid>
    <ProgressBar Value="{Binding Share}" Minimum="0" Maximum="100" Foreground="{ThemeResource TMAccentBrush}" Background="{ThemeResource TMQuietBrush}" Height="3" Margin="0,8,0,0"/>
    </StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
    </Grid></Grid></Border></Grid>
</Grid>
<Border Style="{StaticResource TMCard}" Padding="18,16" Visibility="{Binding HasAnyData, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}">
 <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
 <Border Width="44" Height="44" CornerRadius="12" Background="{ThemeResource TMAccentSoftBrush}" VerticalAlignment="Center"><FontIcon Glyph="&#xE8B7;" Foreground="{ThemeResource TMAccentBrush}" FontSize="21"/></Border>
 <StackPanel Grid.Column="1" Spacing="5"><TextBlock Text="从这台电脑开始记录" FontSize="15" FontWeight="SemiBold"/>
 <TextBlock Text="使用 Claude Code、Codex 等工具后，用量与花费会自动汇总。" Style="{StaticResource TMCaption}" TextWrapping="Wrap"/></StackPanel>
 <Button Grid.Column="2" Content="数据来源" Click="Settings_Click" VerticalAlignment="Center" FontSize="12" Style="{StaticResource TMAction}"/>
 </Grid>
</Border>
<Border Style="{StaticResource TMCard}" Padding="18,14"><StackPanel Spacing="10">
 <Grid><TextBlock Text="使用活动" Style="{StaticResource TMSection}"/><TextBlock Text="{Binding ActivitySummary}" HorizontalAlignment="Right" Style="{StaticResource TMCaption}"/></Grid>
 <Grid x:Name="ActivityPlot" Height="40" AutomationProperties.Name="最近 30 天使用活动"/>
 <Grid><TextBlock Text="{Binding ActivityStart}" Style="{StaticResource TMCaption}" FontSize="11"/><TextBlock Text="今天" HorizontalAlignment="Right" Style="{StaticResource TMCaption}" FontSize="11"/></Grid>
</StackPanel></Border>

</StackPanel><StackPanel x:Name="SessionsPage" Visibility="Collapsed" DataContext="{Binding Sessions}" Spacing="18">
 <ComboBox x:Name="SessionsToolBox" Header="工具" Width="180" SelectedIndex="0" SelectionChanged="SessionsTool_Changed">
 <ComboBoxItem Content="全部工具" Tag=""/><ComboBoxItem Content="Claude Code" Tag="claude"/><ComboBoxItem Content="Codex" Tag="codex"/><ComboBoxItem Content="OpenCode" Tag="opencode"/><ComboBoxItem Content="Hermes" Tag="hermes"/><ComboBoxItem Content="Oh My Pi" Tag="omp"/><ComboBoxItem Content="DeepSeek Harness" Tag="dsh"/></ComboBox>
 <Border Style="{StaticResource TMCard}"><StackPanel Spacing="16"><TextBlock Text="最近会话" Style="{StaticResource TMSection}"/>
 <StackPanel Visibility="{Binding Sessions, Converter={StaticResource ItemsVis}, ConverterParameter=Empty}" Padding="16,32" HorizontalAlignment="Center" MaxWidth="440">
    <Border Width="44" Height="44" CornerRadius="12" Background="{ThemeResource TMQuietBrush}" HorizontalAlignment="Center" Margin="0,0,0,14"><FontIcon Glyph="&#xE8F2;" FontSize="20" Foreground="{ThemeResource TMMutedBrush}"/></Border>
    <TextBlock Text="还没有会话记录" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"/>
    <TextBlock Text="在这台电脑上开始一次 AI 会话，记录会自动出现在这里。" Style="{StaticResource TMCaption}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0"/><Button Content="查看数据来源" Click="Settings_Click" HorizontalAlignment="Center" Margin="0,18,0,0"/></StackPanel>
 <StackPanel Visibility="{Binding Sessions, Converter={StaticResource ItemsVis}}">
    <Grid Padding="12,10" Background="{ThemeResource TMQuietBrush}" CornerRadius="6"><Grid.ColumnDefinitions><ColumnDefinition Width="2.5*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="1.7*"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.3*"/></Grid.ColumnDefinitions><TextBlock Text="会话 / 标题" Grid.Column="0" Style="{StaticResource TMCaption}" Margin="0,0,12,0"/><TextBlock Text="工具" Grid.Column="1" Style="{StaticResource TMCaption}" Margin="0,0,12,0"/><TextBlock Text="模型" Grid.Column="2" Style="{StaticResource TMCaption}" Margin="0,0,12,0"/><TextBlock Text="输入" Grid.Column="3" Style="{StaticResource TMCaption}" Margin="0,0,12,0"/><TextBlock Text="输出" Grid.Column="4" Style="{StaticResource TMCaption}" Margin="0,0,12,0"/><TextBlock Text="花费 · USD" Grid.Column="5" Style="{StaticResource TMCaption}" Margin="0,0,12,0"/></Grid>
    <ListView ItemsSource="{Binding Sessions}" SelectionMode="Single" SelectionChanged="Sessions_SelectionChanged" MaxHeight="320" ItemContainerStyle="{StaticResource TMRows}" BorderThickness="0" Margin="0,4,0,0">
    <ListView.ItemTemplate><DataTemplate><Border Padding="12,12" BorderBrush="{ThemeResource TMLineBrush}" BorderThickness="0,0,0,1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2.5*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="1.7*"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.3*"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="{Binding Title}" FontSize="13" Margin="0,0,12,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding Tool}" FontSize="13" Margin="0,0,12,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="{Binding Model}" FontSize="13" Margin="0,0,12,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><TextBlock Grid.Column="3" Text="{Binding Input, Converter={StaticResource Fmt}, ConverterParameter=N0}" FontSize="13" Margin="0,0,12,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><TextBlock Grid.Column="4" Text="{Binding Output, Converter={StaticResource Fmt}, ConverterParameter=N0}" FontSize="13" Margin="0,0,12,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><TextBlock Grid.Column="5" Text="{Binding Cost, Converter={StaticResource Fmt}, ConverterParameter=USD}" FontSize="13" Margin="0,0,12,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/></Grid></Border></DataTemplate></ListView.ItemTemplate>
    </ListView></StackPanel>
 </StackPanel></Border>
 <Border Style="{StaticResource TMCard}" Visibility="{Binding Turns, Converter={StaticResource ItemsVis}}"><StackPanel Spacing="16"><TextBlock Text="会话明细" Style="{StaticResource TMSection}"/>
 <StackPanel Visibility="{Binding Turns, Converter={StaticResource ItemsVis}}">
    <Grid Padding="12,10" Background="{ThemeResource TMQuietBrush}" CornerRadius="6"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions><TextBlock Text="模型" Grid.Column="0" Style="{StaticResource TMCaption}" Margin="0,0,12,0"/><TextBlock Text="输入" Grid.Column="1" Style="{StaticResource TMCaption}" Margin="0,0,12,0"/><TextBlock Text="输出" Grid.Column="2" Style="{StaticResource TMCaption}" Margin="0,0,12,0"/><TextBlock Text="缓存读取" Grid.Column="3" Style="{StaticResource TMCaption}" Margin="0,0,12,0"/><TextBlock Text="花费 · USD" Grid.Column="4" Style="{StaticResource TMCaption}" Margin="0,0,12,0"/></Grid>
    <ListView ItemsSource="{Binding Turns}" SelectionMode="None" IsItemClickEnabled="False" MaxHeight="260" ItemContainerStyle="{StaticResource TMRows}" BorderThickness="0" Margin="0,4,0,0">
    <ListView.ItemTemplate><DataTemplate><Border Padding="12,12" BorderBrush="{ThemeResource TMLineBrush}" BorderThickness="0,0,0,1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="{Binding Model}" FontSize="13" Margin="0,0,12,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding Input, Converter={StaticResource Fmt}, ConverterParameter=N0}" FontSize="13" Margin="0,0,12,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="{Binding Output, Converter={StaticResource Fmt}, ConverterParameter=N0}" FontSize="13" Margin="0,0,12,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><TextBlock Grid.Column="3" Text="{Binding CacheRead, Converter={StaticResource Fmt}, ConverterParameter=N0}" FontSize="13" Margin="0,0,12,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><TextBlock Grid.Column="4" Text="{Binding Cost, Converter={StaticResource Fmt}, ConverterParameter=USD}" FontSize="13" Margin="0,0,12,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/></Grid></Border></DataTemplate></ListView.ItemTemplate>
    </ListView></StackPanel>
 </StackPanel></Border></StackPanel><StackPanel x:Name="PlansPage" Visibility="Collapsed" DataContext="{Binding Plans}" Spacing="18">
 <Border Style="{StaticResource TMCard}" Visibility="{Binding Subscriptions, Converter={StaticResource ItemsVis}}"><StackPanel Spacing="6"><TextBlock Text="近 30 天日均分摊 · USD" Style="{StaticResource TMCaption}"/><TextBlock Text="{Binding AmortizedDaily, Converter={StaticResource Fmt}, ConverterParameter=USD}" Style="{StaticResource TMNumber}"/></StackPanel></Border>
 <Border Style="{StaticResource TMCard}"><StackPanel Spacing="16"><Grid><TextBlock Text="我的订阅" Style="{StaticResource TMSection}"/><Button Content="管理订阅" Click="Settings_Click" HorizontalAlignment="Right" FontSize="12"/></Grid>
 <StackPanel Visibility="{Binding Subscriptions, Converter={StaticResource ItemsVis}, ConverterParameter=Empty}" Padding="16,32" HorizontalAlignment="Center" MaxWidth="440">
    <Border Width="44" Height="44" CornerRadius="12" Background="{ThemeResource TMQuietBrush}" HorizontalAlignment="Center" Margin="0,0,0,14"><FontIcon Glyph="&#xE8C7;" FontSize="20" Foreground="{ThemeResource TMMutedBrush}"/></Border>
    <TextBlock Text="还没有添加订阅" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"/>
    <TextBlock Text="添加套餐后，可以在这里查看订阅价格和成本分摊。" Style="{StaticResource TMCaption}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0"/><Button Content="添加订阅" Click="Settings_Click" HorizontalAlignment="Center" Margin="0,18,0,0"/></StackPanel>
 <StackPanel Visibility="{Binding Subscriptions, Converter={StaticResource ItemsVis}}">
    <Grid Padding="12,10" Background="{ThemeResource TMQuietBrush}" CornerRadius="6"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions><TextBlock Text="名称" Grid.Column="0" Style="{StaticResource TMCaption}" Margin="0,0,12,0"/><TextBlock Text="套餐" Grid.Column="1" Style="{StaticResource TMCaption}" Margin="0,0,12,0"/><TextBlock Text="周期" Grid.Column="2" Style="{StaticResource TMCaption}" Margin="0,0,12,0"/><TextBlock Text="价格" Grid.Column="3" Style="{StaticResource TMCaption}" Margin="0,0,12,0"/><TextBlock Text="货币" Grid.Column="4" Style="{StaticResource TMCaption}" Margin="0,0,12,0"/></Grid>
    <ListView ItemsSource="{Binding Subscriptions}" SelectionMode="None" IsItemClickEnabled="False"  ItemContainerStyle="{StaticResource TMRows}" BorderThickness="0" Margin="0,4,0,0">
    <ListView.ItemTemplate><DataTemplate><Border Padding="12,12" BorderBrush="{ThemeResource TMLineBrush}" BorderThickness="0,0,0,1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="13" Margin="0,0,12,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding Plan}" FontSize="13" Margin="0,0,12,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="{Binding Cycle}" FontSize="13" Margin="0,0,12,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><TextBlock Grid.Column="3" Text="{Binding Price, Converter={StaticResource Fmt}, ConverterParameter=F2}" FontSize="13" Margin="0,0,12,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><TextBlock Grid.Column="4" Text="{Binding Currency}" FontSize="13" Margin="0,0,12,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/></Grid></Border></DataTemplate></ListView.ItemTemplate>
    </ListView></StackPanel>
 </StackPanel></Border>
 </StackPanel><StackPanel x:Name="AnalysisPage" Visibility="Collapsed" DataContext="{Binding Analysis}" Spacing="18">
 <Border Style="{StaticResource TMCard}"><StackPanel Spacing="16"><TextBlock Text="{Binding PeriodHeading}" Style="{StaticResource TMSection}"/>
 <StackPanel Visibility="{Binding Models, Converter={StaticResource ItemsVis}, ConverterParameter=Empty}" Padding="16,32" HorizontalAlignment="Center" MaxWidth="440">
    <Border Width="44" Height="44" CornerRadius="12" Background="{ThemeResource TMQuietBrush}" HorizontalAlignment="Center" Margin="0,0,0,14"><FontIcon Glyph="&#xE9D9;" FontSize="20" Foreground="{ThemeResource TMMutedBrush}"/></Border>
    <TextBlock Text="暂无用量可供分析" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"/>
    <TextBlock Text="有了本机记录后，在这里比较模型的输入、输出与花费。" Style="{StaticResource TMCaption}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel>
 <StackPanel Visibility="{Binding Models, Converter={StaticResource ItemsVis}}">
    <Grid Padding="12,10" Background="{ThemeResource TMQuietBrush}" CornerRadius="6"><Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="2.5*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="0.7*"/></Grid.ColumnDefinitions><TextBlock Text="工具" Grid.Column="0" Style="{StaticResource TMCaption}" Margin="0,0,12,0"/><TextBlock Text="模型" Grid.Column="1" Style="{StaticResource TMCaption}" Margin="0,0,12,0"/><TextBlock Text="输入" Grid.Column="2" Style="{StaticResource TMCaption}" Margin="0,0,12,0"/><TextBlock Text="输出" Grid.Column="3" Style="{StaticResource TMCaption}" Margin="0,0,12,0"/><TextBlock Text="花费 · USD" Grid.Column="4" Style="{StaticResource TMCaption}" Margin="0,0,12,0"/><TextBlock Text="调用" Grid.Column="5" Style="{StaticResource TMCaption}" Margin="0,0,12,0"/></Grid>
    <ListView ItemsSource="{Binding Models}" SelectionMode="None" IsItemClickEnabled="False"  ItemContainerStyle="{StaticResource TMRows}" BorderThickness="0" Margin="0,4,0,0">
